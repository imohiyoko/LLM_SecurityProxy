#!/usr/bin/env bash
# Blocks commits that contain secrets or terms from a private denylist.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found; install it (https://github.com/gitleaks/gitleaks)" >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner

scripts/check-denylist.sh --staged
